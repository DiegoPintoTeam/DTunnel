[Unit]
Description=DTunnel web panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/DTunnel
ExecStart=/usr/bin/npm run server
Restart=always
RestartSec=2
Environment=NODE_ENV=production
Environment=DTUNNEL_SUPERVISED=1

[Install]
WantedBy=multi-user.target